$TTL 1W

@       IN SOA  ns.stolarek.org.pl. root.stolarek.org.pl. (
        2026070901      ; serial
        3h              ; refresh
        1h              ; retry
        1w              ; expiry
        1d )            ; minimum

        IN NS   ns.stolarek.org.pl.

103     IN PTR  ns.stolarek.org.pl.
116     IN PTR  centos7.stolarek.org.pl.

214     IN PTR  sno.sno.stolarek.org.pl.
215     IN PTR  sno2.sno2.stolarek.org.pl.

; OpenShift nie wymaga PTR dla api/api-int ani *.apps.
; PTR dla wildcard nie istnieje.
